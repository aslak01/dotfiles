# GPG runtime state — keep only config (e.g. gpg.conf).
# gpg-agent.conf is NOT stowed: it's generated by the Makefile (gpg-agent-conf
# target) so the mac-only pinentry-program line stays off the other hosts.
gpg-agent.conf
*.kbx
*.kbx~
*.gpg
random_seed
.gpg-v21-migrated
private-keys-v1.d/
openpgp-revocs.d/
*.lock
S.gpg-agent*
