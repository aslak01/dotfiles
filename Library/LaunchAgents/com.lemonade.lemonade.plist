<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lemonade.lemonade</string>

    <!-- Run via `sh -c` so $HOME expands per-machine (this repo is shared across
         hosts with different usernames). PATH keeps an optional ~/.lemonadebin
         override (used to shim `open` on some machines) ahead of the system path.
         --allow 127.0.0.1 covers the Lima VM too: vz NAT rewrites guest->host
         traffic to 127.0.0.1, so links opened inside the VM reach this server. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec env PATH="$HOME/.lemonadebin:/usr/bin:/bin:/usr/sbin:/sbin" "$HOME/go/bin/lemonade" server --allow 127.0.0.1</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.lemonade.lemonade.stdout</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.lemonade.lemonade.stderr</string>
</dict>
</plist>
